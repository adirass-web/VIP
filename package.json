{
  "name": "toza-site",
  "version": "1.0.0",
  "description": "Toza — personal digital protection for your close circle.",
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve",
    "verify:he-build": "npm run build && node scripts/verify-hebrew-build.mjs",
    "verify:he-copy": "node scripts/verify-hebrew-copy.mjs",
    "verify:leaving-alignment": "node scripts/verify-leaving-alignment.mjs",
    "verify:rtl": "node scripts/verify-rtl.mjs",
    "verify:he-links": "npm run build && node scripts/verify-hebrew-links.mjs",
    "verify:ci-contract": "node scripts/verify-ci-contract.mjs",
    "verify:dossier": "node scripts/verify-dossier-build.mjs",
    "verify:all": "npm run verify:he-build && npm run verify:he-copy && npm run verify:leaving-alignment && npm run verify:rtl && npm run verify:he-links && npm run verify:dossier && npm run verify:ci-contract",
    "test:rtl-visual": "node scripts/run-rtl-visual.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@11ty/eleventy": "^2.0.1"
  }
}
