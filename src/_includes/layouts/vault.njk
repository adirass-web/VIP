{% set t = i18n[locale] %}
{% set routeSuffix = slug + ".html" if slug else "" %}
{% set enLink = "/en/" + routeSuffix %}
{% set heLink = "/he/" + routeSuffix %}
<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description }}">
    {% if meta_keywords %}<meta name="keywords" content="{{ meta_keywords }}">{% endif %}

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ t.og_site_name or 'Toza' }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ og_description if og_description else description }}">
    <meta property="og:url" content="{{ canonical | replace(site.prodUrl, site.url) }}">
    {% set ogImg = (og_image or (site.url + '/assets/img/og-default.png')) | replace(site.prodUrl, site.url) %}
    <meta property="og:image" content="{{ ogImg }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="{{ og_locale }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ og_description if og_description else description }}">
    <meta name="twitter:image" content="{{ ogImg }}">
    <link rel="canonical" href="{{ canonical | replace(site.prodUrl, site.url) }}">
    <link rel="alternate" hreflang="en" href="{{ site.url }}{{ enLink }}">
    <link rel="alternate" hreflang="he" href="{{ site.url }}{{ heLink }}">
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ enLink }}">

    <title>{{ title }}</title>

    {% if visual_system == "controlled-clarity" %}
    <link rel="preload" href="../assets/fonts/david-libre-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
    {% else %}
    <link rel="preload" href="../assets/fonts/playfair-display-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
    {% endif %}
    <link rel="preload" href="../assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    {% if locale == "he" %}<link rel="preload" href="../assets/fonts/david-libre-hebrew-500-normal.woff2" as="font" type="font/woff2" crossorigin>{% endif %}
    <link rel="stylesheet" href="../assets/css/fonts.css">
    <link rel="stylesheet" href="../assets/css/vault.css">
    {% if visual_system == "controlled-clarity" %}<link rel="stylesheet" href="../assets/css/clarity.css">{% endif %}

    {% include "schema-org.njk" %}
</head>
<body{% if body_class %} class="{{ body_class }}{% if devices_test %} devices-test{% endif %}"{% endif %}>

    <a class="skip-link" href="#main-content">{{ t.skip_link or 'Skip to main content' }}</a>

    <header class="site-header">
        <div class="wrap nav">
            <a class="brand" href="/{{ locale }}/" aria-label="Toza — {{ t.nav_home or 'Home' }}">
                {% if visual_system != "controlled-clarity" %}
                <svg class="mark seal" viewBox="0 0 100 100" aria-hidden="true">
                    <circle cx="50" cy="50" r="46" fill="none" stroke-width="2"/>
                    <circle cx="50" cy="50" r="40" fill="none" stroke-width="1" opacity=".5"/>
                    <g fill="none" transform="translate(50 51) scale(.6) translate(-50 -55)">
                        <path d="M24 35 L50 26 L76 35" stroke-width="9"/>
                        <path d="M72 33.6 V48 C72 62 64 74 54 83" stroke-width="7"/>
                        <path d="M55 81 C48 77 43 71 40 64" stroke-width="8"/>
                        <path d="M30 35 V50 C30 55 28 59 26 63" stroke-width="6"/>
                    </g>
                </svg>
                {% endif %}
                <span class="name" dir="ltr">{% if visual_system == "controlled-clarity" %}toza{% else %}Toza{% endif %}</span>
            </a>
            <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-menu">{{ t.menu_label or 'Menu' }}</button>
            <nav class="menu" id="site-menu" aria-label="{{ t.main_nav_label or 'Main navigation' }}">
                <a href="/{{ locale }}/#situations">{{ t.nav_situations or 'Situations' }}</a>
                <a href="/{{ locale }}/why-us.html">{{ t.nav_why or 'Why Toza' }}</a>
                <a href="/{{ locale }}/what-happens-during-the-visit.html">{{ t.nav_what_happens or 'What happens' }}</a>
                <a href="/{{ locale }}/pricing.html">{{ t.nav_pricing or 'Pricing' }}</a>
                <a href="/{{ locale }}/faq.html">{{ t.nav_faq or 'FAQ' }}</a>
                <a class="btn" href="#contact">{% if visual_system == "controlled-clarity" %}Request a private conversation{% else %}{{ t.cta_speak or 'Book an assessment' }}{% endif %}</a>
            </nav>
        </div>
    </header>

    <main id="main-content" tabindex="-1" role="main">
        {{ content | safe }}
    </main>

    <footer class="site-footer">
        <section class="foot-contact" id="contact">
            <div class="wrap">
                {% if visual_system != "controlled-clarity" %}<div class="seal-lg">
                    <svg class="seal" width="56" height="56" viewBox="0 0 100 100" aria-hidden="true">
                        <circle cx="50" cy="50" r="46" fill="none" stroke-width="2"/>
                        <circle cx="50" cy="50" r="40" fill="none" stroke-width="1" opacity=".5"/>
                        <g fill="none" transform="translate(50 51) scale(.6) translate(-50 -55)">
                            <path d="M24 35 L50 26 L76 35" stroke-width="9"/>
                            <path d="M72 33.6 V48 C72 62 64 74 54 83" stroke-width="7"/>
                            <path d="M55 81 C48 77 43 71 40 64" stroke-width="8"/>
                            <path d="M30 35 V50 C30 55 28 59 26 63" stroke-width="6"/>
                        </g>
                    </svg>
                </div>{% endif %}
                <span class="eyebrow" style="justify-content:center">{% if visual_system == "controlled-clarity" %}Private and confidential{% else %}{{ t.footer_eyebrow or 'Confidential' }}{% endif %}</span>
                <h2>{% if visual_system == "controlled-clarity" %}Request a private conversation.{% else %}{{ t.footer_cta_h2 or 'Personal digital protection for your close circle.' }}{% endif %}</h2>
                <p class="sub">{% if visual_system == "controlled-clarity" %}Begin with a short, neutral message. I handle your inquiry personally.{% else %}{{ t.footer_cta_intro or 'Reach out privately, before your private life is used against you.' }}{% endif %}</p>
                <nav class="foot-cta" aria-label="{{ t.footer_cta_nav_label or 'Direct messaging options' }}">
                    <a class="btn" href="{{ t.wa_url }}" target="_blank" rel="noopener noreferrer" onclick="try{window.plausible && window.plausible('CTA: Messenger Click',{props:{platform:'whatsapp'}})}catch(e){}">{{ t.wa_label or 'WhatsApp' }}</a>
                    <a class="btn ghost" href="{{ t.signal_url }}" target="_blank" rel="noopener noreferrer" onclick="try{window.plausible && window.plausible('CTA: Messenger Click',{props:{platform:'signal'}})}catch(e){}">{{ t.signal_label or 'Signal' }}</a>
                </nav>
                {% if visual_system == "controlled-clarity" %}<p class="contact-guidance">Do not send passwords, recovery codes, screenshots, legal documents, intimate details or detailed allegations in the first message.</p>{% endif %}
            </div>
        </section>

        <div class="foot-bar">
            <div class="wrap foot-bar-inner">
                <div class="foot-brand">
                    {% if visual_system != "controlled-clarity" %}
                    <svg class="mark seal" width="30" height="30" viewBox="0 0 100 100" aria-hidden="true">
                        <circle cx="50" cy="50" r="46" fill="none" stroke-width="3"/>
                        <g fill="none" transform="translate(50 51) scale(.58) translate(-50 -55)">
                            <path d="M24 35 L50 26 L76 35" stroke-width="10"/>
                            <path d="M72 33.6 V48 C72 62 64 74 54 83" stroke-width="8"/>
                            <path d="M55 81 C48 77 43 71 40 64" stroke-width="9"/>
                            <path d="M30 35 V50 C30 55 28 59 26 63" stroke-width="7"/>
                        </g>
                    </svg>
                    {% endif %}
                    <span class="fb-name"><bdi dir="ltr">{% if visual_system == "controlled-clarity" %}toza{% else %}Toza{% endif %}</bdi> <span class="fb-tag">{{ t.footer_tag or 'Personal digital protection for your close circle.' }}</span></span>
                </div>
                <nav class="foot-col" aria-label="{{ t.footer_explore or 'Explore' }}">
                    <h3>{{ t.footer_explore or 'Explore' }}</h3>
                    <a href="/{{ locale }}/#situations">{{ t.nav_situations or 'Situations' }}</a>
                    <a href="/{{ locale }}/why-us.html">{{ t.nav_why or 'Why Toza' }}</a>
                    <a href="/{{ locale }}/what-happens-during-the-visit.html">{{ t.nav_what_happens or 'What happens' }}</a>
                    <a href="/{{ locale }}/pricing.html">{{ t.nav_pricing or 'Pricing' }}</a>
                    <a href="/{{ locale }}/faq.html">{{ t.nav_faq or 'FAQ' }}</a>
                    <a href="/{{ locale }}/attorneys.html">{{ t.nav_attorneys or 'For attorneys' }}</a>
                </nav>
                <nav class="foot-col" aria-label="{{ t.footer_legal or 'Legal' }}">
                    <h3>{{ t.footer_legal or 'Legal' }}</h3>
                    <a href="/terms.html" hreflang="en">{{ t.footer_terms or 'Terms of Use' }}</a>
                    <a href="/privacy.html" hreflang="en">{{ t.footer_privacy or 'Privacy' }}</a>
                </nav>
            </div>
            <div class="wrap foot-meta">
                <span>{% if visual_system == "controlled-clarity" %}In person · With you present · No remote access · No cloud processing{% else %}{{ t.trust_line or 'In person only · No remote access · No cloud · No logs · No app' }}{% endif %}</span>
                <span>{{ t.footer_copyright or '© 2026 Toza' }}</span>
            </div>
        </div>
    </footer>

    <script>
    (function(){
      var b=document.querySelector('[data-nav-toggle]'),m=document.getElementById('site-menu');
      if(b&&m){b.addEventListener('click',function(){var o=m.classList.toggle('open');b.setAttribute('aria-expanded',o);});}
      var faqToggle=document.querySelector('[data-faq-toggle-all]');
      if(faqToggle){
        var details=Array.prototype.slice.call(document.querySelectorAll('.faq details'));
        faqToggle.addEventListener('click',function(){
          var expand=faqToggle.getAttribute('aria-expanded')!=='true';
          details.forEach(function(item){item.open=expand;});
          faqToggle.setAttribute('aria-expanded',String(expand));
          faqToggle.textContent=expand?(faqToggle.dataset.closeLabel||'Collapse all'):(faqToggle.dataset.openLabel||'Expand all');
        });
      }
    })();
    </script>
    {% if visual_system != "controlled-clarity" %}<script src="../assets/js/guilloche.js" defer></script>{% endif %}
    {% if visual_system == "controlled-clarity" and page_id == "index" %}
    <script>
    /* Controlled Clarity (Home): scroll-driven field transitions + dimming motif.
       Colour only — never text, never layout. Disabled under prefers-reduced-motion. */
    (function(){
      if(!window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches){return;}
      var body=document.body;
      body.classList.add('js-fields');
      var targets=document.querySelectorAll('[data-field],[data-dimmable]');
      if(!('IntersectionObserver' in window)||!targets.length){
        targets.forEach(function(el){el.classList.add('is-inview');});
        return;
      }
      var observer=new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          entry.target.classList.toggle('is-inview',entry.isIntersecting);
        });
      },{rootMargin:'-18% 0px -18% 0px',threshold:0});
      targets.forEach(function(el){observer.observe(el);});
    })();
    </script>
    {% endif %}

</body>
</html>
