{#
  Base structured data — injected in <head> via base.njk.
  Provides ProfessionalService + Person (Dr. Tabansky) on every page.
  Page-specific schemas (FAQPage, Service) are added per .njk file via a
  `page_schema` front-matter block rendered after this one.
#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "{{ site.url }}/#organization",
      "name": "Personal Cyber Shield",
      "alternateName": ["מגן סייבר אישי", "מגן"],
      "url": "{{ site.url }}",
      "description": "Private-client cyber protection for individuals in high-stakes personal disputes — separation and divorce, business and partner disputes, inheritance conflicts, and similar. One senior expert reviews what your personal digital life may expose and closes it, in person and discreetly. Founded by Dr. Lior Tabansky.",
      "slogan": "Private-client cyber protection.",
      "areaServed": [
        { "@type": "Country", "name": "Israel" }
      ],
      "availableLanguage": ["Hebrew", "English", "Russian"],
      "priceRange": "₪₪₪₪",
      "knowsAbout": [
        "Personal cybersecurity",
        "Personal digital privacy",
        "Account and device security",
        "Divorce and separation digital exposure",
        "Business dispute data protection",
        "Inheritance and estate digital exposure"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Personal Cyber Shield — packages",
        "itemListElement": [
          {
            "@type": "Offer",
            "name": "Private Exposure Assessment",
            "description": "A private, in-person diagnostic with a senior expert. Plain-English summary of what was reviewed, what is most urgent, and what should happen next. Credited in full toward a full package within 14 days.",
            "price": "3500",
            "priceCurrency": "ILS"
          },
          {
            "@type": "Offer",
            "name": "Personal Shield",
            "description": "One person, one primary phone, and every account identified together — a full day of in-person expert work.",
            "price": "14000",
            "priceCurrency": "ILS"
          },
          {
            "@type": "Offer",
            "name": "Inner Circle Shield",
            "description": "Typically several people fully protected. From ₪38,000, priced by scope.",
            "price": "38000",
            "priceCurrency": "ILS"
          },
          {
            "@type": "Offer",
            "name": "Bespoke Private Protection",
            "description": "Fully scoped private protection for complex situations. Priced by arrangement."
          }
        ]
      },
      "founder": { "@id": "{{ site.url }}/en/why-us.html#person" },
      "employee": { "@id": "{{ site.url }}/en/why-us.html#person" }
    },
    {
      "@type": "Person",
      "@id": "{{ site.url }}/en/why-us.html#person",
      "name": "Lior Tabansky",
      "honorificPrefix": "Dr.",
      "givenName": "Lior",
      "familyName": "Tabansky",
      "jobTitle": "Personal Cybersecurity Expert",
      "description": "Two decades advising governments and intelligence agencies on cyber operations across Israel, Asia, Europe, and Africa.",
      "knowsAbout": [
        "Cybersecurity",
        "Device hardening",
        "Intelligence operations",
        "Digital counter-intelligence",
        "Personal privacy"
      ],
      "worksFor": { "@id": "{{ site.url }}/#organization" },
      "url": "https://cyberdrtabansky.com",
      "sameAs": ["https://cyberdrtabansky.com"]
    }
  ]
}
</script>
{% if page_schema %}
<script type="application/ld+json">
{{ page_schema | safe }}
</script>
{% endif %}
