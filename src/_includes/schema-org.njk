{#
  Base structured data — injected in <head> via vault.njk.
  Provides ProfessionalService + Person (Dr. Tabansky) on every EN page.
  Page-specific schemas (FAQPage, Service) are added per .njk file via
  a `page_schema` front-matter block rendered after this one.
#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "{{ site.url }}/#organization",
      "name": "Personal Cyber Shield",
      "alternateName": ["מגן סייבר אישי", "מגן"],
      "url": "{{ site.url }}",
      "description": "Private-client cyber protection for individuals in high-stakes personal disputes and post-incident uncertainty. One senior expert reviews what a client's personal digital life may expose and reduces that exposure in person and discreetly.",
      "slogan": "Private-client cyber protection.",
      "areaServed": [
        { "@type": "Country", "name": "Israel" }
      ],
      "availableLanguage": ["English"],
      "priceRange": "₪₪₪₪",
      "knowsAbout": [
        "Personal cybersecurity",
        "Personal digital privacy",
        "Account and device security",
        "Divorce and separation digital exposure",
        "Business dispute digital exposure",
        "Inheritance and estate digital exposure"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Personal Cyber Shield — packages",
        "itemListElement": [
          {
            "@type": "Offer",
            "name": "Private Exposure Assessment",
            "description": "A private, in-person diagnostic with a senior expert. Plain-English summary of what was reviewed, what appears most urgent, and what should happen next. Credited in full toward a full package within 14 days.",
            "price": "3500",
            "priceCurrency": "ILS"
          },
          {
            "@type": "Offer",
            "name": "Personal Shield",
            "description": "One person, one primary phone, and every relevant account identified together during a full day of in-person expert work.",
            "price": "14000",
            "priceCurrency": "ILS"
          },
          {
            "@type": "Offer",
            "name": "Inner Circle Shield",
            "description": "A multi-person engagement scoped after assessment. From ₪38,000.",
            "price": "38000",
            "priceCurrency": "ILS"
          },
          {
            "@type": "Offer",
            "name": "Bespoke Private Protection",
            "description": "Custom private protection for unusual or highly complex situations. Priced by arrangement."
          }
        ]
      },
      "founder": { "@id": "https://cyberdrtabansky.com/#person" },
      "employee": { "@id": "https://cyberdrtabansky.com/#person" }
    },
    {
      "@type": "Person",
      "@id": "https://cyberdrtabansky.com/#person",
      "name": "Lior Tabansky",
      "honorificPrefix": "Dr.",
      "givenName": "Lior",
      "familyName": "Tabansky",
      "jobTitle": "Cybersecurity Expert",
      "description": "Senior cybersecurity expert, researcher, and advisor.",
      "knowsAbout": [
        "Cybersecurity",
        "National cybersecurity",
        "Cyber strategy and policy",
        "Personal cyber protection"
      ],
      "worksFor": { "@id": "{{ site.url }}/#organization" },
      "url": "https://cyberdrtabansky.com",
      "sameAs": ["https://cyberdrtabansky.com"]
    }
  ]
}
</script>
{% if page_schema %}
<script type="application/ld+json">
{{ page_schema | safe }}
</script>
{% endif %}
